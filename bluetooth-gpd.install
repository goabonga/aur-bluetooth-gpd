# Package hooks run as root: never choose or impersonate a session user.
# The service, its user (sysusers.d), the udev rule and the module list are
# installed under /usr/lib and picked up by the systemd and udev hooks.
post_install() {
  cat <<'MSG'
==> bluetooth-gpd installed. BlueZ refuses the pairing requests, mask it:
      systemctl mask --now bluetooth.service
    Let your user reach the daemon, then log in again:
      usermod -aG bluetooth <user>
    Load the uhid module once (it is loaded at boot from now on), then start
    the service:
      modprobe uhid && udevadm trigger /dev/uhid
      systemctl enable --now bluetooth-daemon
    As your normal user:
      bluetooth
MSG
}

post_remove() {
  cat <<'MSG'
==> The user and group bluetooth and /var/lib/bluetooth, which holds the
    pairing keys, are kept: remove them by hand if you do not need them.
MSG
}
